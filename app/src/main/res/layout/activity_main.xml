<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:fitsSystemWindows="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="NOVA AI" android:textColor="@color/neon_cyan" android:textSize="22sp"
            android:textStyle="bold" android:letterSpacing="0.3"
            android:shadowColor="#00E5FF" android:shadowRadius="18" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/codeSwitch"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Code  " android:textColor="@color/neon_pink" />
        <Button android:id="@+id/btnSettings" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="SET" android:textSize="12sp" android:textStyle="bold" android:textColor="#0A0A14"
            android:background="@null" android:minWidth="48dp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp" android:background="@drawable/bg_hud"
        android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format12Hour="hh:mm a" android:format24Hour="HH:mm"
                android:textColor="@color/neon_cyan" android:textSize="28sp" android:textStyle="bold" />
            <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format12Hour="EEEE, d MMM" android:format24Hour="EEEE, d MMM"
                android:textColor="@color/hint" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="end" android:orientation="vertical">
            <TextView android:id="@+id/weather" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--"
                android:textColor="@color/neon_cyan" android:textSize="15sp" />
            <TextView android:id="@+id/battery" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="BAT --"
                android:textColor="@color/neon_pink" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <com.nova.ai.ArcReactorView android:id="@+id/reactor"
        android:layout_width="match_parent" android:layout_height="170dp" />

    <TextView android:id="@+id/status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center" android:text="STANDBY"
        android:textColor="@color/neon_cyan" android:textSize="12sp" android:letterSpacing="0.4" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/chatList"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:padding="8dp" android:clipToPadding="false" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
        <Button android:id="@+id/btnMic" android:layout_width="52dp" android:layout_height="52dp"
            android:text="MIC" android:textSize="12sp" android:textStyle="bold" android:textColor="#0A0A14" android:background="@drawable/bg_btn" />
        <EditText android:id="@+id/input" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_input" android:hint="Talk to Nova…"
            android:textColor="@color/text" android:textColorHint="@color/hint"
            android:maxLines="4" android:padding="14dp" android:inputType="textMultiLine|textCapSentences" />
        <Button android:id="@+id/btnSend" android:layout_width="52dp" android:layout_height="52dp"
            android:text="SEND" android:textSize="11sp" android:textStyle="bold" android:textColor="#0A0A14" android:background="@drawable/bg_btn" />
    </LinearLayout>
</LinearLayout>
