<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="SETTINGS" android:textColor="@color/neon_cyan" android:textSize="22sp"
            android:textStyle="bold" android:shadowColor="#00E5FF" android:shadowRadius="14" />

        <TextView style="@style/Label" android:text="Gemini API key" />
        <EditText android:id="@+id/apiKey" style="@style/Field"
            android:inputType="textPassword" android:hint="Paste key from aistudio.google.com" />

        <TextView style="@style/Label" android:text="Model" />
        <EditText android:id="@+id/model" style="@style/Field" android:inputType="text" />

        <TextView style="@style/Label" android:id="@+id/tempLabel" android:text="Temperature" />
        <SeekBar android:id="@+id/temp" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="20" />

        <TextView style="@style/Label" android:text="Max output tokens" />
        <EditText android:id="@+id/maxTokens" style="@style/Field" android:inputType="number" />

        <TextView style="@style/Label" android:text="What should Nova call you?" />
        <EditText android:id="@+id/userName" style="@style/Field" android:inputType="textPersonName" />

        <androidx.appcompat.widget.SwitchCompat android:id="@+id/ttsSwitch"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Nova speaks replies aloud"
            android:textColor="@color/text" />

        <Button android:id="@+id/btnA11y" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="Enable screen control (Accessibility)" />
        <Button android:id="@+id/btnClear" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Clear chat history" />
        <Button android:id="@+id/btnSave" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Save" />
    </LinearLayout>
</ScrollView>
